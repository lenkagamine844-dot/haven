rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can only read and write their own Haven data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Their notification devices and upcoming reminder times.
    // The Cloudflare notifier reads these with its own service account.
    match /push/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
